{
  "$defs": {
    "ConcurrencyPerformance": {
      "description": "The probe's burst at the configured concurrency.",
      "properties": {
        "aggregate_tps_local": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregate Tps Local"
        },
        "aggregate_tps_reported": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregate Tps Reported"
        },
        "concurrency": {
          "default": 0,
          "title": "Concurrency",
          "type": "integer"
        },
        "latency_ms": {
          "$ref": "#/$defs/PerfStats"
        },
        "requests": {
          "default": 0,
          "title": "Requests",
          "type": "integer"
        },
        "successes": {
          "default": 0,
          "title": "Successes",
          "type": "integer"
        },
        "ttft_ms": {
          "$ref": "#/$defs/PerfStats"
        },
        "wall_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall Ms"
        }
      },
      "title": "ConcurrencyPerformance",
      "type": "object"
    },
    "DetectorResult": {
      "description": "The result of running one detector.",
      "properties": {
        "dimension": {
          "$ref": "#/$defs/Dimension"
        },
        "duration_ms": {
          "anyOf": [
