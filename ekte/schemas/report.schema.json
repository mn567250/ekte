    "PerformanceReport": {
      "description": "Latency / TTFT / throughput of the audited endpoint(s). The performance\ndetector scores the probe's consistency in its own dimension; these stats\nthemselves never move the verdict's risk level.",
      "properties": {
        "baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/EndpointPerformance"
