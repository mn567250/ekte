            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "status": {
          "$ref": "#/$defs/Status",
          "default": "not_run"
        },
        "weight": {
          "default": 0.0,
