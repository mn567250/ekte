    "KnowledgeUsage": {
      "description": "Which knowledge-base profile a run audited against — and where it came from.\n\n``profile`` is the full resolved profile (provider-level fields plus the one\nmatched model) exactly as used, and ``profile_hash`` its content hash, so a\nreport stays verifiable after the knowledge base changes. How the requested\nid matched (``match_confidence``) is a result of the run, not part of the\nprofile.",
      "properties": {
        "match_confidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match Confidence"
        },
        "matched": {
          "default": false,
          "title": "Matched",
          "type": "boolean"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "model_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Source"
        },
        "pinned": {
          "default": false,
          "title": "Pinned",
          "type": "boolean"
        },
        "pinned_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pinned At"
        },
        "profile": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile"
        },
        "profile_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Hash"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "provider_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Source"
        },
        "requested_model": {
          "title": "Requested Model",
          "type": "string"
        },
        "shadows": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shadows"
        },
        "user_entries": {
          "items": {
            "$ref": "#/$defs/KnowledgeEntryRef"
          },
          "title": "User Entries",
          "type": "array"
        },
        "user_kb": {
          "default": true,
          "title": "User Kb",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "requested_model"
      ],
      "title": "KnowledgeUsage",
      "type": "object"
    },
