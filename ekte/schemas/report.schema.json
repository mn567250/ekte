          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "scoring": {
          "anyOf": [
            {
              "$ref": "#/$defs/DetectorScoring"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/Status",
          "default": "not_run"
        },
        "used_judge": {
          "default": false,
          "title": "Used Judge",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "dimension"
      ],
      "title": "DetectorResult",
      "type": "object"
    },
    "DetectorScoring": {
      "description": "How a detector turns its checks into its score, with the full scale of\npossible outcomes so a report shows what each check could have scored.",
      "properties": {
        "method": {
          "default": "mean_of_checks",
          "title": "Method",
          "type": "string"
        },
        "outcomes": {
          "items": {
            "$ref": "#/$defs/ScoringOutcome"
          },
          "title": "Outcomes",
          "type": "array"
        },
        "titles": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Titles",
          "type": "object"
        }
      },
      "title": "DetectorScoring",
      "type": "object"
    },
    "Dimension": {
      "description": "Scoring dimensions. Each detector contributes to exactly one.",
      "enum": [
        "connectivity",
        "protocol",
        "context_window",
        "model_identity",
        "capability",
        "streaming",
        "billing",
        "reliability",
        "security",
        "performance"
      ],
      "title": "Dimension",
      "type": "string"
    },
    "DimensionBreakdown": {
      "description": "How a dimension's score and status were derived from its detectors.",
      "properties": {
        "detector_status": {
          "$ref": "#/$defs/Status",
          "default": "not_run"
        },
        "detectors": {
          "items": {
            "$ref": "#/$defs/DimensionContribution"
          },
          "title": "Detectors",
          "type": "array"
        },
        "method": {
          "default": "mean_of_detectors",
          "title": "Method",
          "type": "string"
        },
        "status_override": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatusOverride"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "DimensionBreakdown",
      "type": "object"
    },
    "DimensionContribution": {
      "description": "One detector's share in a dimension score.",
      "properties": {
        "counted": {
          "default": false,
          "title": "Counted",
          "type": "boolean"
        },
        "detector": {
          "title": "Detector",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "status": {
          "$ref": "#/$defs/Status",
          "default": "not_run"
        }
      },
      "required": [
        "detector"
      ],
      "title": "DimensionContribution",
      "type": "object"
    },
    "DimensionScore": {
      "properties": {
        "breakdown": {
          "anyOf": [
            {
              "$ref": "#/$defs/DimensionBreakdown"
            },
            {
              "type": "null"
            }
