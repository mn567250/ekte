{
  "$id": "https://raw.githubusercontent.com/mn567250/ekte/main/ekte/schemas/webhook.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "The generic webhook payload (``format_generic`` in ``ekte.notify``).",
  "properties": {
    "base_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Url"
    },
    "claimed_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Claimed Model"
    },
    "event": {
      "default": "audit_alert",
      "title": "Event",
      "type": "string"
    },
    "headline": {
      "title": "Headline",
      "type": "string"
    },
    "key_findings": {
      "items": {
        "type": "string"
      },
      "title": "Key Findings",
      "type": "array"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "previous_risk_level": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Risk Level"
    },
    "rating": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rating"
    },
    "regressed": {
      "title": "Regressed",
      "type": "boolean"
    },
    "risk_level": {
      "title": "Risk Level",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "description": "Version of this schema (MAJOR.MINOR), independent of the ekte version; this schema describes version 1.0. Documents without the field were written before schemas were versioned and match version 1.0.",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Score"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "tool": {
      "default": "ekte",
      "title": "Tool",
      "type": "string"
    }
  },
  "required": [
    "language",
    "text",
    "risk_level",
    "headline",
    "key_findings",
    "regressed"
  ],
  "title": "ekte webhook payload (generic)",
  "type": "object",
  "x-schema-version": "1.0"
}
