{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://raw.githubusercontent.com/mn567250/ekte/main/tests/a11y/manual-review.schema.json",
 "title": "ekte manual accessibility review worksheet",
 "description": "Written by python -m tests.a11y.manual_review --prepare; a person fills in fill_in per session and result/reason/issue/notes per check. Checked by python -m tests.a11y.manual_review --check.",
 "type": "object",
 "required": ["$schema", "schema_version", "generated_from", "setup", "sessions", "checks"],
 "additionalProperties": false,
 "properties": {
  "$schema": {"type": "string"},
  "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
  "about": {"type": "string"},
  "generated_from": {
   "type": "object",
   "description": "The conformance report the worksheet was prepared from.",
   "additionalProperties": false,
   "properties": {
    "commit": {"type": ["string", "null"]},
    "ekte_version": {"type": ["string", "null"]},
    "tests_run_at": {"type": ["string", "null"]}
   }
  },
  "setup": {"type": "string"},
  "sessions": {
   "type": "object",
   "additionalProperties": {"$ref": "#/$defs/session"}
  },
  "checks": {
   "type": "array",
   "items": {"$ref": "#/$defs/check"}
  }
 },
 "$defs": {
  "text_or_null": {"type": ["string", "null"], "minLength": 1},
  "session": {
   "type": "object",
   "required": ["setup", "fill_in"],
   "additionalProperties": false,
   "properties": {
    "setup": {
     "type": "object",
     "description": "Generated; do not edit.",
     "required": ["label", "assistive_technology", "browser", "os", "input", "language", "theme"],
     "additionalProperties": false,
     "properties": {
      "label": {"type": "string"},
      "assistive_technology": {"type": ["string", "null"]},
      "browser": {"type": "string"},
      "os": {"type": "string"},
      "input": {"type": "string"},
      "language": {"type": "string"},
      "theme": {"type": "string"}
     }
    },
    "fill_in": {
     "type": "object",
     "description": "Filled in by the person who did the session, before any of its checks is answered.",
     "required": ["by", "date", "ekte_version", "at_version", "browser_version", "os_version"],
     "additionalProperties": false,
     "properties": {
      "by": {"$ref": "#/$defs/text_or_null", "description": "Name or GitHub handle of the person who did the checks."},
      "date": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "Date of the session, YYYY-MM-DD."},
      "ekte_version": {"$ref": "#/$defs/text_or_null", "description": "ekte version tested (ekte --version)."},
      "at_version": {"$ref": "#/$defs/text_or_null", "description": "Version of the assistive technology; null when the session uses none."},
      "browser_version": {"$ref": "#/$defs/text_or_null"},
      "os_version": {"$ref": "#/$defs/text_or_null"}
     }
    }
   }
  },
  "check": {
   "type": "object",
   "required": ["id", "step", "title", "page", "url", "session", "tools", "do", "expect", "result", "reason", "issue", "notes"],
   "additionalProperties": false,
   "properties": {
    "id": {"type": "string", "pattern": "^9(\\.[0-9]+)+/[a-z]+/[a-z-]+/[a-z0-9-]+$"},
    "step": {"type": "string", "pattern": "^9(\\.[0-9]+)+$"},
    "title": {"type": "string"},
    "page": {"type": "string"},
    "url": {"type": "string"},
    "session": {"type": "string"},
    "lang": {"type": "string"},
    "theme": {"type": "string"},
    "width": {"type": "string"},
    "zoom": {"type": "string"},
    "tools": {"type": "array", "items": {"type": "string"}},
    "do": {"type": "string"},
    "expect": {"type": "string"},
    "result": {
     "type": ["boolean", "null"],
     "description": "true: the expectation holds; false: it does not (give issue); null with reason: not applicable; null without reason: not done yet."
    },
    "reason": {"$ref": "#/$defs/text_or_null", "description": "Why the check does not apply (only with result null)."},
    "issue": {"type": ["string", "null"], "pattern": "^https?://\\S+$", "description": "Follow-up issue of a failed check."},
    "notes": {"$ref": "#/$defs/text_or_null"}
   },
   "allOf": [
    {"if": {"properties": {"result": {"const": false}}, "required": ["result"]},
     "then": {"properties": {"issue": {"type": "string"}}}},
    {"if": {"properties": {"result": {"type": "boolean"}}, "required": ["result"]},
     "then": {"properties": {"reason": {"type": "null"}}}}
   ]
  }
 }
}
